# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Next.js / Node / Editor / OS ignores

# Node dependencies
/node_modules/

# Environment files (do NOT commit secrets)
.env
.env.*
!.env.example

# Next.js build output
/.next/
/out/

# Build artifacts
/dist/
/build/

# Yarn Plug'n'Play
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Cache and temporary files
.cache/
/.parcel-cache/
/.next/cache/
*.tmp
*.temp

# Logs
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*
logs/
*.log

# Coverage
/coverage/

# Vercel/Netlify/other hosting
.vercel/
/.vercel
/.netlify

# Editor directories and files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# OS generated files
.DS_Store
Thumbs.db
*.swp

# Optional: lockfiles (uncomment if your team decides locks should be ignored)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Misc
*.pem
next-env.d.ts
*.tsbuildinfo
