PORT=5000

# Database postgreSQL
DATABASE_URL="postgresql://user:password@host:port/dbname"

# RPC Provider APIS
ALCHEMY_API_KEY="your_alchemy_api_key_here"
ETH_MAINNET_NET_URL="https://eth-mainnet.g.alchemy.com/v2/your_alchemy_api_key_here"
BNB_MAINNET_NET_URL="https://bnb-mainnet.g.alchemy.com/v2/your_alchemy_api_key_here"
BASE_MAINNET_NET_URL="https://base-mainnet.g.alchemy.com/v2/your_alchemy_api_key_here"
ARBITRUM_MAINNET_NET_URL="https://arb-mainnet.g.alchemy.com/v2/your_alchemy_api_key_here"
SOL_MAINET_NET_URL="https://solana-mainnet.g.alchemy.com/v2/your_alchemy_api_key_here"

# IMPORTANT => for prod:(TXSHIELD_ENV=mainnet)
TXSHIELD_ENV=local

# for simulation
SIMULATOR_WALLET_ADDRESS="your_simulator_wallet_address_here"

# Etherscan
ETHERSCAN_API_ENDPOINT="https://api.etherscan.io/v2/api?chainId=1"
ETHERSCAN_API_KEY="your_etherscan_api_key_here"

# CoinGecko
COIN_GECKO_NAME_SYMBOL_API="https://api.coingecko.com/api/v3/coins/list"
COIN_GECKO_SEPECIFIC_ID="https://api.coingecko.com/api/v3/coins/%7Bid%7D"
COINGECKO_API_USD="https://api.coingecko.com/api/v3/simple/price"

# Email Configuration
MY_EMAIL="your_email@example.com"
CONTACT_EMAIL_PASS="your_email_app_password"
CONTECT_EMAIL="your_contact_email@example.com"

# AI Model Configuration
DEEPSEEK_URL="https://openrouter.ai/api/v1/chat/completions"
MODEL_API_KEY="your_ai_model_api_key_here"
MODEL_NAME="deepseek/deepseek-r1-0528:free"

# Site Info
SITE_URL="http://localhost:3000/"
SITE_NAME="TxShield"

# Redis
REDIS_URL=redis://127.0.0.1:6379
REDIS_DB=0
REDIS_EXPIRY_SECONDS=86400
